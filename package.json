{
  "name": "cripto-terminal",
  "private": true,
  "version": "2.0.0",
  "description": "Terminal de trading en vivo para MetaTrader 5 y Binance, con indicadores, replay y freno de disciplina.",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "postinstall": "npm --prefix web install --no-audit --no-fund",
    "prestart": "npm run build",
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "test": "node --test \"test/*.test.ts\"",
    "test:ui": "node scripts/revisar-ui.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.9.0"
  }
}
