# Todo es opcional: sin .env la terminal arranca con estos mismos valores.

# ---------------------------------------------------------------------------
# Mercado (Binance, solo datos publicos: no hace falta clave)
# ---------------------------------------------------------------------------
# Cripto. Cada una necesita su perpetuo en Binance Futures (mapa de liquidacion,
# open interest y liquidaciones).
SYMBOLS=BTCUSDT
# Perpetuos de Binance sin spot (TradFi): velas, open interest y liquidaciones
# del perpetuo, con mapa de liquidacion. Tambien hay XPTUSDT, XPDUSDT, CLUSDT...
PERPETUOS=XAUUSDT
BINANCE_REST_BASE=https://api.binance.com
BINANCE_WS_BASE=wss://stream.binance.com:9443
BINANCE_FUTURES_REST=https://fapi.binance.com
BINANCE_FUTURES_WS=wss://fstream.binance.com/market
# Tu cuenta de futuros de Binance en Operar (saldo, posiciones y ordenes): una API
# key con permiso de futuros, SIN retiros y con tu IP habilitada.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# false (por defecto): solo mirar. Con SL obligatorio, ninguna orden sale (ni se queda) sin stop loss.
BINANCE_TRADING=false
BINANCE_SL_OBLIGATORIO=true

# Velas en memoria por temporalidad (se piden de a 1000). Con menos de ~1400 la
# EMA 200 no llega a dar lo mismo que TradingView.
HISTORY_MES=200
HISTORY_1W=500
HISTORY_1D=1500
HISTORY_4H=1500
HISTORY_1H=1500
HISTORY_15M=1500
HISTORY_5M=1500
HISTORY_1M=1500

# ---------------------------------------------------------------------------
# Indices (Yahoo Finance, gratis y sin clave)
# ---------------------------------------------------------------------------
# nombre en la terminal:simbolo de Yahoo. Por defecto los futuros de CME, que
# cotizan casi 24 horas; el contado (^DJI, ^NDX, ^GSPC) solo en horario de bolsa.
INDICES=US30:YM=F,US100:NQ=F,US500:ES=F,USOIL:CL=F,USDCLP:CLP=X
# Segundos entre lecturas en vivo (con el mercado cerrado, una por minuto)
INDICES_CADA=15


# ---------------------------------------------------------------------------
# Indicadores (los mismos valores que en TradingView)
# ---------------------------------------------------------------------------
EMA_FAST=10
EMA_SLOW=50
EMA_LARGA=200
ADX_DI_LENGTH=14
ADX_SMOOTHING=14
ADX_CLAVE=23
SQZ_BB_LENGTH=20
SQZ_BB_MULT=2.0
SQZ_KC_LENGTH=20
SQZ_KC_MULT=1.5
SQZ_USE_TRUE_RANGE=true

# ---------------------------------------------------------------------------
# Estructura
# ---------------------------------------------------------------------------
# Estructura de semanal y diario: velas a cada lado de un giro.
BIAS_SWING=5
# Filas de los perfiles de volumen (VPVR y VPSV): 24 es lo de TradingView.
VP_FILAS=24
# Temporalidad con la que arranca la vista, hasta que el navegador pide la suya.
GATILLO_TF=1h

# ---------------------------------------------------------------------------
# Puente MetaTrader 5 (solo lectura: cuenta, posiciones, cotizaciones y velas)
# ---------------------------------------------------------------------------
# Al arrancar, abrir MT5 con el puente (Windows). MT5_TERMINAL: el terminal64.exe
# a usar si hay mas de una instalacion (vacio = la que ya tiene el puente).
MT5_LANZAR=true
# Pestaña Operar: mandar ordenes a MT5 por el EA CriptoTerminalOperador (cada una se
# confirma; el EA solo opera la cuenta de su InpCuenta). Viene apagada: true la enciende.
TRADING_ACTIVO=false

# Cabina de riesgo de la cuenta de fondeo (FTMO por defecto). El balance inicial
# sale del primer deposito del historial de MT5; aca se puede fijar a mano.
PROP_BALANCE_INICIAL=
PROP_DIARIA_PCT=5
PROP_MAXIMA_PCT=10
PROP_ZONA=Europe/Prague

# Historial en Google Sheets (ver README): la clave JSON de una cuenta de servicio
# (guardala fuera del repo) y el id de la planilla compartida con su mail.
GOOGLE_CREDENCIALES=
SHEETS_ID=
SHEETS_CADA=60

MT5_TERMINAL=
# Indices con las velas del broker (en vivo) mientras el puente publica; si no, Yahoo.
MT5_VELAS=true
# Vacio = autodetectar. Ver mt5/LEEME.md para instalar el EA que escribe el JSON.
MT5_STATE_FILE=
MT5_ACCOUNT=
MT5_MAX_AGE=15
# Simbolo de la terminal -> simbolo del broker. US30, US100 y US500 van siempre
# como US30.cash, US100.cash y US500.cash (FTMO); se pueden pisar aca.
MT5_SYMBOL_MAP=BTCUSDT:BTCUSD,ETHUSDT:ETHUSD,ADAUSDT:ADAUSD,XLMUSDT:XLMUSD,XRPUSDT:XRPUSD

# Sin el puente: capital de referencia y tamano de contrato por simbolo del
# broker (MT5 -> Market Watch -> clic derecho -> Especificacion).
MT5_ACCOUNT_EQUITY=10000
MT5_CONTRACT_SIZE=ADAUSD:100000,XLMUSD:100000,XRPUSD:10000,BTCUSD:1,ETHUSD:10
MT5_VOLUME_STEP=0.01
MT5_VOLUME_MIN=0.01

# Fraccion del nocional que el broker exige como margen (cripto FTMO: 1.0).
MT5_MARGIN_RATE_DEFAULT=1.0
MT5_MARGIN_RATE=

# ---------------------------------------------------------------------------
# USDT.D reconstruida con CoinGecko (gratis, sin clave)
# ---------------------------------------------------------------------------
USDTD_ACTIVA=true
# Opcional: clave "demo" gratuita de coingecko.com/en/api (carga mucho mas rapido)
COINGECKO_API_KEY=
USDTD_CADA=180
USDTD_MONEDAS=bitcoin,ethereum,tether,ripple,binancecoin,solana,usd-coin,dogecoin,cardano,tron

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8787
# Acceso desde el celular con Tailscale Serve (ver README): su direccion .ts.net
ACCESO_REMOTO=
ABRIR_NAVEGADOR=true
PUSH_INTERVAL=0.4
RESYNC_SECONDS=180

# El mercado del replay: el que tiene la historia larga del puente.
REPLAY_SIMBOLO=US100
# Riesgo por operacion que propone Operar: lo que queda hasta el limite de la cuenta
# de fondeo repartido en RIESGO_AGUANTAR SL seguidos (sube con las ganancias y baja con
# las perdidas), como mucho RIESGO_PCT % del balance. RIESGO_AGUANTAR=0: solo el %.
RIESGO_PCT=0.5
RIESGO_AGUANTAR=0

# Freno de disciplina: al perder FRENO_PERDIDA_DIA_USD en el dia de la firma (lo
# cerrado y lo abierto), no se abre mas hasta el corte del dia (bloquear) o solo
# avisa (avisar). Tambien puede frenar por % del balance, por perdidas seguidas o
# por cantidad de operaciones. 0 apaga cada regla.
FRENO_PERDIDA_DIA_USD=30
FRENO_PERDIDA_DIA_PCT=0
FRENO_PERDIDAS=0
FRENO_OPERACIONES=2
FRENO_MODO=bloquear
# Con el freno bloqueando, lo que se abre directo en MT5 (o en el celular): cancelar
# (cancela las ordenes nuevas), avisar (solo en el registro) o no. Las posiciones nunca
# se cierran. Lo que ya estaba no se toca.
FRENO_MT5=no
# Minutos sin abrir despues de cada salida (tambien en MT5, con FRENO_MT5). 0 lo apaga.
FRENO_PAUSA_MIN=0
# El SL inicial es el techo: no se puede ampliar, y lo ampliado directo en MT5 vuelve a
# su lugar (si el precio ya lo paso, no se toca). Acercarlo siempre se puede.
FRENO_SL_INICIAL=false
# Minutos que tarda en quitarse la pausa de la cuenta real despues de pedirlo.
FRENO_PAUSA_SALIR_MIN=10

# Corte automatico: a lo abierto SIN stop loss (MT5 y Binance) se le pone un SL en el
# broker donde la perdida llega a CORTE_AUTO_USD; si ya perdio eso, no se toca. Lo que
# tiene SL tampoco. 0 lo apaga.
CORTE_AUTO_USD=30

# Los sonidos de NinjaTrader (OrderFilled.wav, StopFilled.wav, TargetFilled.wav...):
# vacio los busca en sonidos/ del proyecto y donde los instala NinjaTrader 8.
SONIDOS_CARPETA=
# La voz de NinjaTrader: vacio en ingles ("Order filled"), es-ES en castellano.
SONIDOS_IDIOMA=
